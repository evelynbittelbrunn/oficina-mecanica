# Copy to .env and adjust the values. The .env file must NEVER be committed.

# Database
POSTGRES_DB=workshop
POSTGRES_USER=workshop
POSTGRES_PASSWORD=change-me

# JWT: HMAC secret with at least 32 characters (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-random-secret-of-32-or-more-characters
JWT_EXPIRATION=PT2H

# Demo users (created on startup if they do not exist)
DEMO_ADMIN_EMAIL=admin@oficina.com
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_ATTENDANT_EMAIL=atendente@oficina.com
DEMO_ATTENDANT_PASSWORD=change-me-atendente

# Port exposed by the application in docker compose
APP_PORT=8080

# Optional: NVD API key to speed up OWASP Dependency-Check
# NVD_API_KEY=
